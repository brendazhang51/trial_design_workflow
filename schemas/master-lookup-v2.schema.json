        "base_disposition",
        "authority_scope",
        "authority_refs",
        "min_records",
        "max_records",
        "repeat_key",
        "tsgrpid_rule_id",
        "sort_key",
        "value_profile_id",
        "fact_key",
        "derivation_id",
        "value_map_id",
        "automation_level",
        "evidence_requirements",
        "review_reason",
        "notes"
