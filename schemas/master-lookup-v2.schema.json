          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Repeat Key",
          "type": "array"
        },
        "review_reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Review Reason",
          "type": "string"
        },
        "sort_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sort Key",
          "type": "string"
        },
        "tsgrpid_rule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
