    "ApplicabilityRule": {
      "additionalProperties": false,
      "properties": {
        "authority_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Authority Refs",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "on_false": {
          "enum": [
            "include",
            "exclude",
            "manual_assessment",
            "needs_external_source"
          ],
          "title": "On False",
          "type": "string"
        },
        "on_true": {
          "enum": [
            "include",
            "exclude",
            "manual_assessment",
            "needs_external_source"
          ],
          "title": "On True",
          "type": "string"
        },
        "on_unknown": {
          "enum": [
            "manual_assessment",
            "needs_external_source"
          ],
          "title": "On Unknown",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "title": "Priority",
          "type": "integer"
        },
        "rule_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "version",
        "priority",
        "predicate",
        "on_true",
        "on_false",
        "on_unknown",
        "explanation",
        "authority_refs"
      ],
      "title": "ApplicabilityRule",
      "type": "object"
    },
    "DerivationRule": {
