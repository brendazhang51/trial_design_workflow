        "min_records": {
          "minimum": 0,
          "title": "Min Records",
          "type": "integer"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "parameter_status": {
          "enum": [
            "active",
            "deprecated",
            "not_in_selected_release"
          ],
