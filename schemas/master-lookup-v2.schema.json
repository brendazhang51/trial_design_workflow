          "type": "string"
        },
        "concept_code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Concept Code",
          "type": "string"
        },
        "ct_release": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Ct Release",
          "type": "string"
        },
        "derivation_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Derivation Id",
          "type": "string"
        },
        "evidence_requirements": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Evidence Requirements",
          "type": "string"
        },
        "fact_key": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
